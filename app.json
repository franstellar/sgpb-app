      "package": "com.franboisesteam.sgpbapp",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/images/icon-paelito.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "d3c6e400-fdc6-4b54-8e62-c76e1ed0e2e5"
      }
